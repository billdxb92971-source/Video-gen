# --- Single-key setup (recommended if you only want to pay one provider) ---
# Get this from fal.ai (fal.ai/dashboard/keys). With FAL_KEY alone, the app runs
# entirely on fal.ai: script writing via "fal-llm" (Qwen), video via Seedance/
# Kling/Grok Imagine. No Gemini account needed.
FAL_KEY=your_fal_api_key_here

# --- Optional: adds Gemini as an extra option (not required) ---
# Get this from Google AI Studio (ai.google.dev) - paid-tier Gemini API key.
# Only needed if you want the "gemini" script provider or the "veo" video provider.
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the fal.ai model slugs if they change (check https://fal.ai/models)
# FAL_SEEDANCE_MODEL=fal-ai/bytedance/seedance/v2/text-to-video
# FAL_KLING_MODEL=fal-ai/kling-video/v3/pro/text-to-video
# FAL_GROK_MODEL=fal-ai/grok-imagine/text-to-video
# FAL_LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Optional
PORT=3000
